NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
# Railway: reference the PostgreSQL service's DATABASE_URL. Local dev uses SQLite if empty.
DATABASE_URL=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
# Register PUBLIC_URL/auth/chzzk/callback in Chzzk developer console.
# Required scope: user info lookup only. No chat access is requested.
# Restrict AI spending to invited channels (comma-separated channel IDs); empty permits all signed-in channels.
ALLOWED_CHANNEL_IDS=
ALLOW_DEV_LOGIN=false
MOCK_AI=false
