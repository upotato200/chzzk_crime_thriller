{
  "name": "profiler-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env profiler/server/index.js",
    "dev": "node --env-file-if-exists=.env --watch profiler/server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check profiler/server/index.js && node --check profiler/dist/app.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.16.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^30.1.1"
  }
}
